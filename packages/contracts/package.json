{
  "name": "@dexa/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=../../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=env=node,esModuleInterop=true,outputServices=grpc-js,useExactTypes=false,importSuffix=.js --proto_path=proto proto/grpc/health/v1/health.proto proto/dexa/identity/v1/identity.proto",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@grpc/grpc-js": "1.14.4",
    "protobufjs": "8.8.0"
  }
}
