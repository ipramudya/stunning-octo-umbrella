{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortImports": {
    "groups": [
      "side_effect",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "functions": ["clsx", "cva", "tw", "twMerge", "cn", "twJoin", "tv"],
    "stylesheet": "./apps/web/src/app/globals.css"
  },
  "ignorePatterns": [
    ".agents/**",
    ".local/**",
    "package-lock.json",
    "packages/contracts/src/generated/**"
  ]
}
