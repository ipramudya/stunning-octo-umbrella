{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": "../../.swcrc"
      }
    },
    "deleteOutDir": true,
    "typeCheck": true
  },
  "sourceRoot": "src"
}
